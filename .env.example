# Required for persistent accounts and user data
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Optional Schoology OAuth 1.0 app credentials (server only)
SCHOOLOGY_CONSUMER_KEY=
SCHOOLOGY_CONSUMER_SECRET=
SCHOOLOGY_CALLBACK_URL=http://localhost:3000/api/integrations/schoology/callback
INTEGRATION_ENCRYPTION_KEY=GENERATE_A_32_BYTE_BASE64_KEY

# Optional AI; Ollama endpoint must be reachable by the server
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5:3b

# Optional Discord bot notifications
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# Optional Web Push VAPID credentials
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional email provider
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Scheduled jobs; use a long random secret in production
CRON_SECRET=
